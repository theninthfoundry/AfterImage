# Hindsight Cloud (promo code MEMHACK99) or self-hosted (e.g. http://localhost:8888)
HINDSIGHT_URL=https://api.hindsight.vectorize.io
HINDSIGHT_API_KEY=
HINDSIGHT_BANK=afterimage

# Structured audit trail (runs + stages + graph), separate from Hindsight.
# Defaults to a local SQLite file if unset. For anything beyond a demo, point
# this at Postgres, e.g. postgresql+psycopg://afterimage:afterimage@db:5432/afterimage
DATABASE_URL=sqlite:///./afterimage.db

# Optional: an LLM writes the lesson that gets stored. Without a key a templated
# lesson is stored and the UI says so.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
